# Groq — Whisper / vision / synthesis specialists
GROQ_API_KEY=
# On-demand OTPM is often 1000; keep these below that.
GROQ_VISION_MAX_TOKENS=512
GROQ_SYNTHESIS_MAX_TOKENS=800

# Claude Agent SDK (Anthropic API). Optional if using Bedrock.
ANTHROPIC_API_KEY=

# auto | claude | pipeline
AGENT_BACKEND=auto
AGENT_MAX_TURNS=12
AGENT_MAX_BUDGET_USD=0.50
# sdk = in-process MCP; stdio = spawn mcp_server.py
MCP_TRANSPORT=sdk

# Application sandbox (always on)
SANDBOX_ROOT=./sandbox_workspace
TOOL_TIMEOUT_SEC=120
MAX_FILE_BYTES=26214400
# Optional second layer: Claude Agent SDK bubblewrap sandbox
CLAUDE_SDK_SANDBOX=0

# Vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Amazon Bedrock — only set to 1 if `aws configure` / IAM role actually works.
# CLAUDE_CODE_USE_BEDROCK=1 without AWS credentials makes the CLI hang on
# initialize (Control request timeout).
CLAUDE_CODE_USE_BEDROCK=0
AWS_REGION=us-east-1
AWS_MEETING_BUCKET=
AWS_MEETING_PREFIX=meetings/

# Optional live internal HTTP API. Empty = fixture directory/calendar.
INTERNAL_API_BASE_URL=
